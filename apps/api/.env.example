# Copia este archivo a .env (apps/api/.env) para desarrollo local.

# Postgres de docker-compose.yml (puerto 5434 en el host)
DATABASE_URL=postgresql://tb:tb@localhost:5434/touched_block

# Secreto para firmar los JWT de acceso (mínimo 32 caracteres en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-desarrollo

# Client IDs de OAuth de Google aceptados como audiencia del idToken (separados por coma).
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# Audiencias de Sign in with Apple (bundle id / services id), separadas por coma. Opcional.
APPLE_AUDIENCES=

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:8081

PORT=3000

# Solo desarrollo local: con 1, POST /auth/google acepta idToken = "dev:<sub>:<nombre>" sin Google
# (el cliente lo usa con EXPO_PUBLIC_AUTH_DEV_FAKE=1). Se ignora si NODE_ENV=production.
# AUTH_DEV_FAKE=1

# Secreto de la semilla del reto diario (HMAC-SHA256 de la fecha). Obligatorio en producción
# (32+ caracteres); en desarrollo y tests, si falta, se usa un valor fijo de desarrollo.
# DAILY_SECRET=

# Opcionales:
# THROTTLE_LIMIT=120          # peticiones por minuto por IP (límite general)
# CLEANUP_INTERVAL_MS=3600000 # limpieza de partidas de invitado (0 = desactivada)
# TRUST_PROXY=loopback, linklocal, uniquelocal
