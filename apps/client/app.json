{
  "expo": {
    "name": "Touched Block",
    "slug": "touched-block",
    "scheme": "touchedblock",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12121a",
    "icon": "./public/icon-512.png",
    "android": {
      "package": "app.touchedblock",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono/android-foreground.png",
        "backgroundImage": "./assets/icono/android-background.png",
        "monochromeImage": "./assets/icono/android-foreground.png",
        "backgroundColor": "#0091ff"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "icon": "./assets/icono/icon-movil.png"
    },
    "ios": {
      "bundleIdentifier": "app.touchedblock",
      "supportsTablet": false,
      "icon": "./assets/icono/icon-movil.png"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "es"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Roboto",
                "path": "./src/assets/fonts/roboto-variable.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  },
                  {
                    "weight": 700
                  },
                  {
                    "weight": 800
                  },
                  {
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "./plugins/withShortCxxPath",
      "./plugins/withReleaseSigning",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ]
    ]
  }
}
