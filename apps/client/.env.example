# Copia este archivo a apps/client/.env (o define las variables en el entorno / en CI).
# Sin EXPO_PUBLIC_API_URL y EXPO_PUBLIC_GOOGLE_CLIENT_ID el juego queda solo para invitados
# (historial local, sin pestañas ni rankings).

# URL de la API, sin "/" al final (local: http://localhost:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Client ID web de OAuth de Google (orígenes autorizados: https://sukushaing.github.io y http://localhost:8081).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# Solo desarrollo: muestra un formulario "Entrar (dev)" para iniciar sesión sin Google.
# Requiere la API con AUTH_DEV_FAKE=1. No usar en producción.
# EXPO_PUBLIC_AUTH_DEV_FAKE=1
