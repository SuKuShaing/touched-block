# Variables para la pestaña "Environment" del Compose en Dokploy (ver docs/despliegue.md).
# Copia este archivo a deploy/.env (ignorado por git), complétalo y pega su contenido en Dokploy.
# Nunca subas los valores reales al repositorio: es público.

# Contraseña de Postgres (solo letras y números: va dentro de la URL de conexión).
# Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# OJO: se fija la primera vez que se crea la base; cambiarla después no cambia la del volumen.
POSTGRES_PASSWORD=

# Secreto para firmar los JWT (48 bytes aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Secreto de la semilla del reto diario: HMAC-SHA256(DAILY_SECRET, fecha). Obligatorio (la API no
# arranca sin él; mínimo 32 caracteres). Nadie puede adivinar la partida de mañana sin conocerlo.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# OJO: no lo cambies después de publicarlo; cambiaría la partida del día en curso a mitad del día.
DAILY_SECRET=

# Client ID web de OAuth de Google (no es secreto: también va en la web).
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# Sign in with Apple (app iOS y web). Pasos en docs/despliegue.md, sección 6.
# Audiencias del identityToken = bundle ID (iOS, primero) y Services ID (web). Sin ella, POST /auth/apple responde 503.
APPLE_AUDIENCES=app.touchedblock,app.touchedblock.web
# Revocación del token de Apple al eliminar la cuenta (si falta alguna, se omite con un aviso).
# APPLE_PRIVATE_KEY = contenido del .p8 en una sola línea, con \n en vez de los saltos de línea. SECRETO.
APPLE_CLIENT_ID=app.touchedblock
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Clave para cifrar el token de Apple (opcional, 32+ caracteres; p. ej. openssl rand -base64 48). Sin ella se
# deriva de JWT_SECRET. SECRETO; una vez definida no se cambia (los tokens cifrados con ella dejarían de leerse).
APPLE_TOKEN_KEY=

# Orígenes que pueden llamar a la API, separados por coma: la web (Cloudflare) y la vieja de
# GitHub Pages (solo redirige, pero una pestaña abierta desde antes sigue llamando a la API).
CORS_ORIGINS=https://web.touchedblock.app,https://sukushaing.github.io

# Moderación (guía 1.2 de Apple): secreto de los endpoints /admin/* (cabecera X-Admin-Token). SECRETO.
# Vacío = /admin/* responde 404 (los scripts de moderación funcionan igual). Mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Guía: docs/despliegue.md, sección "Moderación".
ADMIN_TOKEN=

# Moderación: aviso por Telegram con cada reporte nuevo (opcionales; si falta alguna no se envía nada).
# TELEGRAM_BOT_TOKEN = el token que entrega @BotFather. SECRETO.
# TELEGRAM_CHAT_ID = tu chat id (número; lo muestra `node scripts/telegram-test.mjs --chat-id`).
# Guía: docs/despliegue.md, sección 7, "Avisos por Telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Versión de la imagen de la API. "latest" = la última publicada; para volver atrás: v0.1.0, etc.
API_TAG=latest
