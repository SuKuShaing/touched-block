# Variables para la pestaña "Environment" del Compose en Dokploy (ver docs/despliegue.md).
# Copia este archivo a deploy/.env (ignorado por git), complétalo y pega su contenido en Dokploy.
# Nunca subas los valores reales al repositorio: es público.

# Contraseña de Postgres (solo letras y números: va dentro de la URL de conexión).
# Genera una con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# OJO: se fija la primera vez que se crea la base; cambiarla después no cambia la del volumen.
POSTGRES_PASSWORD=

# Secreto para firmar los JWT (48 bytes aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Client ID web de OAuth de Google (no es secreto: también va en la web).
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com

# Orígenes que pueden llamar a la API (la web en GitHub Pages).
CORS_ORIGINS=https://sukushaing.github.io

# Versión de la imagen de la API. "latest" = la última publicada; para volver atrás: v0.1.0, etc.
API_TAG=latest
